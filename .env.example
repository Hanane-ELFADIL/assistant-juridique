# ============================================================
# Assistant Juridique RAG — Bank Al-Maghrib
# Copier vers .env et remplir les valeurs
# NE JAMAIS committer .env dans Git
# ============================================================

# === MODE RECOMMANDÉ : Ollama local (aucune clé API) ===
LLM_MODE=ollama
EMBEDDING_MODEL=ollama

# === Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Google API (optionnel — fallback si Ollama indisponible) ===
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it

# === Base de données ===
DATABASE_URL=sqlite:///./data/bam_rag.db

# === Vectorstore ===
VECTOR_DB_DIR=./data/vector_db
VECTOR_COLLECTION_NAME=bam_legal_chunks

# === Chemins ===
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# === API ===
API_HOST=127.0.0.1
API_PORT=8000
MAX_PDF_SIZE_MB=50
MAX_QUERY_LENGTH=500
MAX_CONTEXT_CHUNKS=8
RETRIEVAL_TOP_K=15

# === Logs ===
LOG_LEVEL=INFO
LOG_DIR=./logs
