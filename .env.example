# ============================================================
# Assistant Juridique RAG — Bank Al-Maghrib
# Copiez ce fichier vers .env et remplissez vos vraies valeurs.
# NE JAMAIS committer le fichier .env dans Git.
# ============================================================

# === LLM Google Gemini (obligatoire) ===
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# === Base de données (SQLite par défaut) ===
DATABASE_URL=sqlite:///./data/bam_rag.db

# === Vectorstore ChromaDB ===
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=bam_legal_chunks

# === Chemins des données ===
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# === API ===
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false

# === Limites ===
MAX_PDF_SIZE_MB=50
MAX_QUERY_LENGTH=500
MAX_CONTEXT_CHUNKS=8
RETRIEVAL_TOP_K=10

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=./logs
